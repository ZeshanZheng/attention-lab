{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"]
  },
  "include": ["web/**/*.ts", "web/**/*.tsx", "src/**/*.ts", "vite.config.ts", "playwright.config.ts", "tests/browser/**/*.ts"]
}
