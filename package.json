{
  "name": "attention-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.12.0 <25" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "build": "tsc --project tsconfig.build.json",
    "demo": "node examples/default-experiment.ts",
    "verify": "npm run typecheck && npm test && npm run build && npm run demo"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
